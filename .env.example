# Razorpay — get keys from https://dashboard.razorpay.com (use test keys first)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id

# Google OAuth — create an app at https://console.cloud.google.com/apis/credentials
# Redirect URI must be exactly: https://YOUR_DOMAIN/api/auth/google/callback
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret

# Admin login
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Secrets — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change_this_session_secret
ORDER_ENCRYPTION_KEY=change_this_encryption_key
OTP_ENCRYPTION_KEY=change_this_otp_encryption_key

# Public links (exposed to browser)
NEXT_PUBLIC_DISCORD_LINK=https://discord.gg/your-server
NEXT_PUBLIC_WHATSAPP_NUMBER=+1-XXX-XXX-XXXX
